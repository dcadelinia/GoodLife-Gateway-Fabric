import os
import yaml
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from test_launcher import MobiusLoopOrchestrator, NvidiaSpatialSimulationEngine

# Initialize the Web Server Network
app = FastAPI(
    title="GoodLifeGateway System Fabric API",
    description="Live Multi-Agent Gateway Interface linking OpenAI, NVIDIA, Perplexity, BlackRock, and Amazon infrastructure layers.",
    version="1.0.0"
)

# Enable CORS cross-origin connections so your live website can safely fetch data from this server
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"], # In production, restrict this strictly to ['https://odynexaxis.biz']
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Define the web payload model for incoming infrastructure issues
class TelemetryAnomalyRequest(BaseModel):
    anomaly_description: str

@app.get("/")
def read_root():
    """
    Heartbeat endpoint used by cloud health checks to confirm web engine uptime.
    """
    return {
        "status": "ONLINE",
        "node_id": "REGIONAL_NODE_SOWEGA",
        "target_operational_uptime": "98.7%",
        "framework_version": "50_YEAR_MOBIUS_LOOP"
    }

@app.post("/api/v1/simulation/optimize")
def run_grid_optimization(payload: TelemetryAnomalyRequest):
    """
    Main webhook triggered by your website or sensors. Ingests a raw anomaly,
    orchestrates a multi-agent solution contract, updates the digital twin, and returns live status values.
    """
    if not payload.anomaly_description:
        raise HTTPException(status_code=400, detail="Telemetry request must contain a valid description.")
        
    try:
        # 1. Initialize Multi-Agent Components
        orchestrator = MobiusLoopOrchestrator()
        sim_engine = NvidiaSpatialSimulationEngine()
        
        # 2. Run OpenAI Cognitive Core Reasoning + Perplexity Real-Time Grounding
        validated_contract = orchestrator.process_grid_anomaly(payload.anomaly_description)
        
        # 3. Apply structural adjustments to NVIDIA OpenUSD Scene Graph & GR00T Policy
        sim_engine.apply_autonomous_asset_defense(validated_contract)
        
        # 4. Return clean, structured telemetry JSON metrics directly back to your web interface
        return {
            "success": True,
            "system_action": validated_contract.target_action,
            "compliance_verified": validated_contract.is_compliant,
            "optimized_lane_nodes": validated_contract.optimized_routing_lane,
            "gamified_lore_update": validated_contract.narrative_alert_string,
            "enterprise_analytics": {
                "blackrock_aladdin_yield_delta": f"+{validated_contract.capital_metrics.instant_treasury_yield_delta * 100}%",
                "blackrock_portfolio_insulation": validated_contract.capital_metrics.portfolio_insulation_score,
                "amazon_fleet_throughput_efficiency": f"{validated_contract.supply_chain.fleet_throughput_efficiency * 100}%",
                "amazon_fulfillment_routing_node": validated_contract.supply_chain.fulfillment_routing_node,
                "perplexity_regulatory_sources": validated_contract.external_intel.regulatory_citations
            },
            "nvidia_embodied_ai": {
                "gr00t_hardware_target": validated_contract.gr00t_policy.target_embodiment_id,
                "gr00t_motion_policy_override": validated_contract.gr00t_policy.workflow_override,
                "gr00t_trajectory_path": validated_contract.gr00t_policy.trajectory_node_path
            }
        }
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Sovereign Möbius loop internal breakdown: {str(e)}")

if __name__ == "__main__":
    import uvicorn
    # Starts the local development listener engine when running standalone local configurations
    uvicorn.run("main.py", host="0.0.0.0", port=8000, reload=True)
